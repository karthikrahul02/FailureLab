FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_AUTH_MODE=demo
ARG VITE_COGNITO_USER_POOL_ID=
ARG VITE_COGNITO_CLIENT_ID=
ARG VITE_ENABLE_REAL_FIS=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL VITE_AUTH_MODE=$VITE_AUTH_MODE VITE_COGNITO_USER_POOL_ID=$VITE_COGNITO_USER_POOL_ID VITE_COGNITO_CLIENT_ID=$VITE_COGNITO_CLIENT_ID VITE_ENABLE_REAL_FIS=$VITE_ENABLE_REAL_FIS
RUN npm run build
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
